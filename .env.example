# PostgreSQL connection string (required for accounts, projects and saved runs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/builddoctor?schema=public"

# Auth token signing secret: generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# GitHub API token with read access to Actions logs for private repositories.
# Only required if you want the webhook to fetch logs automatically.
GITHUB_TOKEN=""

# Optional webhook URL is /api/webhooks/github. Create a project in the app
# and use the webhook secret shown at project creation as the GitHub webhook secret.
NODE_ENV="development"