generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  projects     Project[]
  runs         PipelineRun[]
}

model Project {
  id             String        @id @default(cuid())
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  fullName       String
  defaultBranch  String        @default("main")
  webhookSecret  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  runs           PipelineRun[]

  @@unique([ownerId, fullName])
  @@index([ownerId, updatedAt])
}

model PipelineRun {
  id           String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repository    String
  workflowName  String   @default("Manual analysis")
  branch        String   @default("unknown")
  commitSha     String?
  status        String   @default("failed")
  durationMs    Int?
  logText       String   @db.Text
  issueCount    Int      @default(0)
  createdAt     DateTime @default(now())
  issues        DiagnosticIssue[]

  @@index([ownerId, createdAt])
  @@index([projectId, createdAt])
}

model DiagnosticIssue {
  id          String      @id @default(cuid())
  runId       String
  run         PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  title       String
  severity    String
  category    String
  file        String?
  line        Int?
  evidence    String
  explanation String      @db.Text
  fix         String      @db.Text
  command     String?
  confidence  Int
  fingerprint String
  createdAt   DateTime    @default(now())

  @@index([runId])
  @@index([fingerprint])
}