  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.2",
    "prisma": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
